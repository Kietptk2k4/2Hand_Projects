# Copy to .env and adjust for your machine.
# Hosts/ports match Infrastructure/docker-compose.yml published ports.
#
# When running Python/uvicorn on the HOST (PowerShell), use localhost + published ports.
# When running inside Docker Compose network, use service hostnames (postgres-commerce:5432).
# Always use postgresql:// for psycopg — never jdbc:postgresql:// (Spring-only).

SOCIAL_POSTGRES_URL=postgresql://postgres:123456@localhost:5433/social_db
SOCIAL_MONGO_URL=mongodb://localhost:27017
SOCIAL_MONGO_DB=social_db

COMMERCE_POSTGRES_URL=postgresql://postgres:123456@localhost:5434/commerce_db
AUTH_POSTGRES_URL=postgresql://postgres:123456@localhost:5432/auth_db

RECSYS_DATASET_OUTPUT_DIR=data/cleaned
RECSYS_ARTIFACT_DIR=data/artifacts
RECSYS_HOME_SIM_DIR=data/home_sim
RECSYS_HOME_ARTIFACT_DIR=data/home_artifacts

# Required for home-sim / seed-db writers (dev only)
RECSYS_SIM_ALLOW=1

# Home LTR train-mode (dev): skip Admin HTTP and use these values
RECSYS_HOME_CONFIG_FROM_ENV=1
HOME_LTR_TRAIN_DATA_MODE=SEED_ONLY
HOME_LTR_SEED_ROW_WEIGHT=0.5
HOME_LTR_REAL_ONLY_MIN_IMPRESSIONS=5000

# Optional Admin HTTP (production orchestrator; leave blank when RECSYS_HOME_CONFIG_FROM_ENV=1)
# ADMIN_BASE_URL=http://localhost:3005
# ADMIN_SERVICE_TOKEN=
